async function uploadImg(inp, targetId = 'p_image') {

  const f = inp.files[0]; if (!f) return;

  const path = Date.now() + '_' + f.name.replace(/[^\w.]/g, '') || Date.now() + '.jpg';

  toast('جاري رفع الصورة...');

  const { error } = await db.storage.from('products').upload(path, f);

  if (error) return toast(error.message, false);

  const url = db.storage.from('products').getPublicUrl(path).data.publicUrl;

  $(targetId).value = url; toast('تم الرفع ✅');

}

async function uploadAdminImage(inp,targetId){
