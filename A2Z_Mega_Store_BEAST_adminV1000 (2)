const waNum = p => { p = String(p || '').replace(/\D/g, ''); return p.startsWith('0') ? '20' + p.slice(1) : p; };



function toast(m, ok = true) {

  const d = document.createElement('div');

  d.className = 'px-4 py-2.5 rounded-xl text-sm font-bold text-white shadow-lg ' + (ok ? 'bg-emerald-600' : 'bg-rose-600');

  d.textContent = m; $('toasts').appendChild(d); setTimeout(() => d.remove(), 3000);

}

function modal(h) { $('modal-body').innerHTML = h; $('modal').classList.remove('hidden'); }

function closeModal() { $('modal').classList.add('hidden'); }

async function rows(t, col = 'id') { const { data, error } = await db.from(t).select('*').order(col, { ascending: false }); if (error) toast(error.message, false); return data || []; }



/* ====== التحقق والصلاحيات ====== */

async function login(e) {

  e.preventDefault();

  const { error } = await db.auth.signInWithPassword({ email: $('email').value.trim(), password: $('pass').value });

  if (error) return toast('بيانات الدخول غلط أو الحساب غير مسجل', false);

  start();

}

async function logout() { await db.auth.signOut(); location.reload(); }



async function start() {

  const { data: { session } } = await db.auth.getSession();

  if (!session) return;



  const { data: adm, error } = await db.from('admins').select('*').eq('id', session.user.id).single();

  if (error || !adm) {

    await db.auth.signOut();

    return toast('عذراً، هذا الحساب ليس له صلاحيات أدمن', false);

  }

  S.currentAdmin = adm;

  $('header-store-name').textContent = S.settings.store_name || 'لوحة إدارة المتجر';

  $('current-admin-badge').textContent = `${adm.name} (${adm.role === 'owner' ? 'المالك' : 'مساعد'})`;



  $('login').classList.add('hidden'); 

  $('app').classList.remove('hidden');



  await loadAll();
  applyAdminBrandTheme();



  const allowedTabs = ALL_TABS.filter(([key, label, perm]) => {

    if (adm.role === 'owner') return true;

    return adm.permissions[perm] === true || key === 'stats';

  });



  $('tabs').innerHTML = allowedTabs.map(([k, l]) => `<button data-t="${k}" onclick="show('${k}')" class="tab">${l}</button>`).join('');



  show(allowedTabs[0] ? allowedTabs[0][0] : 'stats');

  subscribe();

}



async function loadAll() {

  const [c, p, o, s] = await Promise.all([db.from('categories').select('*').order('sort_order'), rows('products'), rows('orders'), db.from('settings').select('*')]);

  S.cats = c.data || []; S.products = p; S.orders = o;

  S.settings = Object.fromEntries((s.data || []).map(x => [x.key, x.value]));

}



function subscribe() {

  db.channel('orders-live').on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'orders' }, p => {

    S.orders.unshift(p.new); toast('🔔 طلب جديد رقم #' + p.new.id);

    if (['orders', 'stats'].includes(S.tab)) show(S.tab);

  }).subscribe();

}



function show(t) {

  S.tab = t;

  document.querySelectorAll('#tabs .tab').forEach(b => b.classList.toggle('on', b.dataset.t === t));

  ({ stats: vStats, orders: vOrders, products: vProducts, cats: vCats, coupons: vCoupons, wheel: vWheel, reviews: vReviews, team: vTeam, promotions: vPromotions, luxe: vLuxe, requests: vRequests, settings: vSettings })[t]();

}



/* ====== الإحصائيات ====== */

function vStats() {

  const ok = S.orders.filter(o => o.status !== 'ملغي'), today = new Date().toDateString();

  const sum = l => l.reduce((a, o) => a + Number(o.total_price), 0);

  const days = [...Array(7)].map((_, i) => {

    const d = new Date(); d.setDate(d.getDate() - (6 - i));

    return { l: d.toLocaleDateString('ar-EG', { weekday: 'short' }), v: sum(ok.filter(o => new Date(o.created_at).toDateString() === d.toDateString())) };

  });

  const mx = Math.max(...days.map(d => d.v), 1);

  const low = S.products.filter(p => p.stock <= 5);

  const top = [...S.products].sort((a, b) => (b.sales_count || 0) - (a.sales_count || 0)).slice(0, 5);

  const box = (l, v, c) => `<div class="card p-4"><p class="text-xs text-slate-500">${l}</p><p class="text-xl font-black ${c}">${v}</p></div>`;

  $('view').innerHTML = `

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">

      ${box('إيرادات اليوم', money(sum(ok.filter(o => new Date(o.created_at).toDateString() === today))), 'text-emerald-600')}

      ${box('إجمالي الإيرادات', money(sum(ok)), 'text-indigo-600')}

      ${box('كل الطلبات', S.orders.length, '')}

      ${box('طلبات قيد المراجعة', S.orders.filter(o => o.status === 'قيد المراجعة').length, 'text-amber-600')}

      ${box('عدد العملاء', new Set(S.orders.map(o => o.customer_phone)).size, '')}

      ${box('عدد المنتجات', S.products.length, '')}

      ${box('متوسط قيمة الطلب', money(ok.length ? sum(ok) / ok.length : 0), '')}

      ${box('منتجات مخزونها قليل', low.length, 'text-rose-600')}

    </div>

    <div class="grid md:grid-cols-2 gap-4">

      <div class="card p-4"><h3 class="font-black mb-3">مبيعات آخر 7 أيام</h3>

        <div class="flex items-end gap-2 h-40">${days.map(d => `<div class="flex-1 flex flex-col items-center justify-end h-full">

          <span class="text-[10px] text-slate-500">${d.v ? Math.round(d.v) : ''}</span>

          <div class="w-full bg-indigo-500 rounded-t-lg" style="height:${Math.max(d.v / mx * 100, 2)}%"></div>

          <span class="text-[10px] mt-1">${d.l}</span></div>`).join('')}</div></div>

      <div class="card p-4"><h3 class="font-black mb-3">🏆 الأكثر مبيعاً</h3>

        ${top.map(p => `<div class="flex justify-between text-sm py-1.5 border-b last:border-0"><span class="truncate">${esc(p.name)}</span><b>${p.sales_count || 0} قطعة</b></div>`).join('') || '<p class="text-slate-400 text-sm">لسه مفيش مبيعات</p>'}

        <h3 class="font-black mt-4 mb-2">⚠️ مخزون قليل</h3>

        ${low.map(p => `<div class="flex justify-between text-sm py-1"><span class="truncate">${esc(p.name)}</span><b class="${p.stock <= 0 ? 'text-rose-600' : 'text-orange-500'}">${p.stock}</b></div>`).join('') || '<p class="text-slate-400 text-sm">كله تمام ✅</p>'}

      </div>

    </div>`;

}



