async function saveSettings(e) {

  e.preventDefault(); const fd = new FormData(e.target);

  toast('جاري الحفظ...');

  for (let [key, value] of fd.entries()) {

    await db.from('settings').upsert({ key, value: value.trim() });

    S.settings[key] = value.trim();

  }

  applyAdminBrandTheme();
  previewAdminPalette();
  toast('تم حفظ الإعدادات بنجاح ✅');

  $('header-store-name').textContent = S.settings.store_name || 'لوحة إدارة المتجر';

}




/* ===== لوحة التحكم: الوضع النهاري والليلي المتحرك ===== */
function toggleAdminTheme(){setAdminTheme(document.documentElement.classList.contains('dark')?'light':'dark',true)}
function setAdminTheme(mode,animate=false){
 const root=document.documentElement,dark=mode==='dark',reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 if(animate&&!reduce){root.classList.add('admin-theme-smooth');root.classList.toggle('dark',dark);clearTimeout(window.__adminThemeTimer);window.__adminThemeTimer=setTimeout(()=>root.classList.remove('admin-theme-smooth'),720)}
 else{root.classList.toggle('dark',dark);root.classList.remove('admin-theme-smooth')}
 localStorage.setItem('a2z_admin_theme',mode);
 const i=document.getElementById('admin-theme-icon'),l=document.getElementById('admin-theme-label');if(i)i.textContent=dark?'🌙':'☀️';if(l)l.textContent=dark?'الوضع الداكن':'الوضع الفاتح';
}

