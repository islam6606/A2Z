<script>


/* ===== A2Z Club operations: campaigns and customer requests ===== */
async function vPromotions(){
 const {data,error}=await db.from('promotions').select('*').order('sort_order');
 const rows=data||[];
 $('view').innerHTML=`<div class="space-y-4"><div class="card p-5"><h3 class="font-black text-xl mb-1">إدارة العروض والحملات</h3><p class="text-xs mb-4">أنشئ عروضاً تظهر للزوار عند تفعيلها، أو أوقفها دون حذفها.</p><form onsubmit="addPromotion(event)" class="grid md:grid-cols-2 gap-3"><input name="title" required class="inp" placeholder="عنوان العرض"><div class="space-y-2"><input name="image_url" id="promo_image_url" class="inp" dir="ltr" placeholder="رابط صورة العرض (اختياري)" oninput="document.getElementById('promo_image_preview').src=this.value;document.getElementById('promo_image_preview').classList.toggle('hidden',!this.value)"><label class="ghost cursor-pointer inline-flex items-center gap-2">📁 اختيار من الاستوديو<input type="file" accept="image/*" class="hidden" onchange="uploadAdminImage(this,'promo_image_url')"></label><img id="promo_image_preview" class="hidden max-h-32 rounded-xl object-contain" alt="معاينة صورة العرض"></div><textarea name="description" class="inp md:col-span-2" placeholder="وصف العرض"></textarea><input name="code" class="inp" placeholder="كود الخصم (اختياري)"><input name="sort_order" type="number" class="inp" value="0" placeholder="ترتيب العرض"><label class="flex items-center gap-2 text-sm"><input name="active" type="checkbox"> تفعيل العرض فوراً</label><button class="btn md:col-span-2">إضافة العرض</button></form></div><div class="grid md:grid-cols-2 gap-3">${rows.map(x=>`<div class="card p-4"><div class="flex justify-between gap-2"><b>${esc(x.title)}</b><span class="text-xs ${x.active?'text-emerald-400':'text-amber-400'}">${x.active?'نشط':'متوقف'}</span></div><p class="text-xs my-2">${esc(x.description||'بدون وصف')}</p><div class="flex gap-2"><button class="ghost" onclick="togglePromotion(${x.id},${!x.active})">${x.active?'إيقاف':'تفعيل'}</button><button class="danger" onclick="deletePromotion(${x.id})">حذف</button></div></div>`).join('')||'<div class="card p-5">لا توجد عروض بعد.</div>'}</div></div>`;
 if(error)toast(error.message,false);
}
async function addPromotion(e){e.preventDefault();const f=new FormData(e.target);const {error}=await db.from('promotions').insert({title:f.get('title'),image_url:f.get('image_url')||null,description:f.get('description')||'',code:f.get('code')||null,sort_order:Number(f.get('sort_order')||0),active:f.get('active')==='on'});if(error)return toast(error.message,false);toast('تمت إضافة العرض');vPromotions()}
async function togglePromotion(id,active){const {error}=await db.from('promotions').update({active}).eq('id',id);if(error)return toast(error.message,false);vPromotions()}
async function deletePromotion(id){if(!confirm('حذف العرض نهائياً؟'))return;const {error}=await db.from('promotions').delete().eq('id',id);if(error)return toast(error.message,false);vPromotions()}
async function vRequests(){const {data,error}=await db.from('product_requests').select('*').order('created_at',{ascending:false});$('view').innerHTML=`<div class="card p-5"><h3 class="font-black text-xl mb-2">اقتراحات المنتجات من العملاء</h3><p class="text-xs mb-4">بيانات العملاء الخاصة لا تظهر في هذه القائمة؛ المعروض هو الاقتراح وحالته فقط.</p><div class="space-y-3">${(data||[]).map(r=>`<article class="border-b border-slate-700 pb-3"><div class="flex flex-wrap justify-between gap-2"><b>${esc(r.product_name)}</b><span class="text-xs">${dt(r.created_at)}</span></div><p class="text-xs my-1">${esc(r.brand_specs||'')}</p><p class="text-xs">${esc(r.notes||'')}</p><div class="flex flex-wrap gap-2 mt-2"><select id="req-status-${r.id}" class="inp !w-auto"><option ${r.status==='جديد'?'selected':''}>جديد</option><option ${r.status==='قيد الدراسة'?'selected':''}>قيد الدراسة</option><option ${r.status==='تمت الإضافة'?'selected':''}>تمت الإضافة</option><option ${r.status==='غير متاح'?'selected':''}>غير متاح</option></select><input id="req-note-${r.id}" class="inp flex-1" placeholder="ملاحظة داخلية" value="${esc(r.admin_note||'')}"><button class="btn" onclick="saveRequest(${r.id})">حفظ</button></div></article>`).join('')||'<p>لا توجد اقتراحات حتى الآن.</p>'}</div></div>`;if(error)toast(error.message,false)}
async function saveRequest(id){const status=$('req-status-'+id).value,admin_note=$('req-note-'+id).value;const {error}=await db.from('product_requests').update({status,admin_note}).eq('id',id);if(error)return toast(error.message,false);toast('تم تحديث الاقتراح')}

/* ====== الإعدادات ====== */

const SUPABASE_URL = 'https://obmlxotktttofpxrdpwr.supabase.co';

const SUPABASE_KEY = 'sb_publishable_5Qd36HMri9ll-SdwKQ0_9A_oHmcbs9d';

const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);



