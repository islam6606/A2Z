function exportCSV() {

  const h = ['رقم', 'الاسم', 'الموبايل', 'المدينة', 'العنوان', 'المنتجات', 'الإجمالي', 'الدفع', 'الحالة', 'التاريخ'];

  const r = S.orders.map(o => [o.id, o.customer_name, o.customer_phone, o.city, o.customer_address,

    (o.items || []).map(i => i.name + ' x' + i.qty).join(' | '), o.total_price, o.payment_method, o.status, dt(o.created_at)]);

  const csv = [h, ...r].map(l => l.map(c => '"' + String(c ?? '').replace(/"/g, '""') + '"').join(',')).join('\n');

  const a = document.createElement('a');

  a.href = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8' }));

  a.download = 'orders.csv'; a.click();

}



