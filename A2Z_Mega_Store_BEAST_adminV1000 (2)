(async function init() {

  setAdminTheme(localStorage.getItem('a2z_admin_theme') || 'light', false);

  const { data: { session } } = await db.auth.getSession();

  if (session) {

    start();

  } else {

    $('login').classList.remove('hidden');

  }

})();

</script>

<script id="a2z-luxe-admin-js">
const LX_DEF_FAQ=[{q:'إزاي أتابع طلبي؟',a:'من القائمة الجانبية اختار «تتبع الطلب» وادخل رقم موبايلك أو رقم الطلب.'},{q:'هل في استرجاع واستبدال؟',a:'أيوه، تقدر تتواصل معانا على واتساب وهنساعدك في أسرع وقت حسب سياسة المتجر.'},{q:'إزاي أستخدم كوبون الخصم؟',a:'اكتب الكود في السلة واضغط تطبيق، والخصم هيتحسب فوراً.'},{q:'إيه هي عجلة الحظ؟',a:'لعبة من القائمة الجانبية تكسب منها خصومات ومكافآت حسب إعدادات المتجر.'}];
const lxJ=(k,d)=>{try{const v=JSON.parse(S.settings[k]);return v==null?d:v}catch{return d}};
const lxLocal=iso=>{if(!iso)return '';const d=new Date(iso);if(isNaN(d))return '';d.setMinutes(d.getMinutes()-d.getTimezoneOffset());return d.toISOString().slice(0,16)};
async function lxSet(key,val){const {error}=await db.from('settings').upsert({key,value:JSON.stringify(val)});if(error){toast(error.message,false);return false}S.settings[key]=JSON.stringify(val);return true}
function vLuxe(){
 const f=lxJ('lx_flash',{enabled:true,title:'⚡ عروض الساعة الذهبية',sub:'خصومات حصرية تتجدد كل يوم - الحق قبل ما تخلص',btn:'تسوق العروض ←',link:'#catalog',end_at:''});
 window.LXF=lxJ('lx_faq',LX_DEF_FAQ).map(x=>({q:x.q||'',a:x.a||''}));
 const url=S.settings.store_public_url||'';
 $('view').innerHTML=`<div class="space-y-4">
 <div class="card p-5"><h3 class="font-black text-xl mb-1">⏳ العرض بوقت (عروض الساعة الذهبية)</h3><p class="text-xs mb-4">يظهر في المتجر مع عدّاد تنازلي. لو سبت وقت الانتهاء فاضي، العدّاد بيتجدد كل يوم عند منتصف الليل. بعد انتهاء الوقت المحدد، العرض بيختفي تلقائياً.</p>
 <div class="grid md:grid-cols-2 gap-3">
 <label class="flex items-center gap-2 text-sm md:col-span-2"><input id="lxf_on" type="checkbox" ${f.enabled!==false?'checked':''}> إظهار العرض في المتجر</label>
 <input id="lxf_title" class="inp" placeholder="عنوان العرض" value="${esc(f.title)}">
 <input id="lxf_sub" class="inp" placeholder="وصف قصير" value="${esc(f.sub)}">
 <input id="lxf_btn" class="inp" placeholder="نص الزر" value="${esc(f.btn)}">
 <input id="lxf_link" class="inp" dir="ltr" placeholder="رابط الزر (#catalog أو https://...)" value="${esc(f.link||'#catalog')}">
 <div class="md:col-span-2"><label class="text-xs font-bold">وقت انتهاء العرض (تاريخ وساعة)</label><input id="lxf_end" type="datetime-local" class="inp mt-1" value="${lxLocal(f.end_at)}">
 <div class="flex gap-2 flex-wrap mt-2"><button type="button" class="ghost" onclick="lxQuick(1)">بعد ساعة</button><button type="button" class="ghost" onclick="lxQuick(6)">بعد 6 ساعات</button><button type="button" class="ghost" onclick="lxQuick(24)">بعد يوم</button><button type="button" class="ghost" onclick="lxQuick(72)">بعد 3 أيام</button><button type="button" class="ghost" onclick="lxQuick(168)">بعد أسبوع</button><button type="button" class="ghost" onclick="lxQuick(0)">مسح (تجديد يومي)</button></div></div>
 <button class="btn md:col-span-2" onclick="lxSaveFlash()">حفظ العرض ✅</button></div></div>
 <div class="card p-5"><h3 class="font-black text-xl mb-1">❓ الأسئلة الشائعة</h3><p class="text-xs mb-4">أضف أو عدّل أو احذف أو رتّب الأسئلة والإجابات. لو مسحت الكل، القسم بيختفي من المتجر.</p><div id="lx-faq-edit" class="space-y-3"></div>
 <div class="flex gap-2 mt-3 flex-wrap"><button type="button" class="ghost" onclick="lxFaqAdd()">➕ إضافة سؤال</button><button type="button" class="btn" onclick="lxSaveFaq()">حفظ الأسئلة ✅</button></div></div>
 <div class="card p-5"><h3 class="font-black text-xl mb-1">📱💻 معاينة على الأجهزة</h3><p class="text-xs mb-3">اكتب رابط متجرك بعد الرفع، وشوف شكله على الموبايل والتابلت والكمبيوتر. المتجر نفسه بيشتغل على أي جهاز تلقائياً.</p>
 <div class="flex gap-2 flex-wrap"><input id="lx_url" class="inp flex-1" dir="ltr" placeholder="https://your-store.com" value="${esc(url)}"><button class="btn" onclick="lxSaveUrl()">حفظ</button><button class="ghost" onclick="lxCopyUrl()">نسخ الرابط</button><a class="ghost" id="lx_open" target="_blank" rel="noopener" href="${esc(url)||'#'}">فتح ↗</a></div>
 <div class="flex gap-2 mt-3"><button class="ghost" onclick="lxPrev(390)">📱 موبايل</button><button class="ghost" onclick="lxPrev(820)">📟 تابلت</button><button class="ghost" onclick="lxPrev('100%')">💻 كمبيوتر</button></div>
 <div class="mt-3 overflow-auto"><iframe id="lx_frame" title="معاينة المتجر" style="width:390px;max-width:100%;height:640px;border:1px solid #C9A25E;border-radius:18px;margin:auto;display:block;background:#fff" src="${esc(url)}"></iframe></div></div></div>`;
 lxFaqRender();
}
function lxQuick(h){const e=$('lxf_end');if(!h){e.value='';return}const d=new Date(Date.now()+h*36e5);d.setMinutes(d.getMinutes()-d.getTimezoneOffset());e.value=d.toISOString().slice(0,16)}
async function lxSaveFlash(){const v=$('lxf_end').value;const o={enabled:$('lxf_on').checked,title:$('lxf_title').value.trim(),sub:$('lxf_sub').value.trim(),btn:$('lxf_btn').value.trim(),link:$('lxf_link').value.trim()||'#catalog',end_at:v?new Date(v).toISOString():''};if(await lxSet('lx_flash',o))toast('تم حفظ العرض ✅')}
function lxFaqRender(){$('lx-faq-edit').innerHTML=window.LXF.map((x,i)=>`<div class="border rounded-2xl p-3 space-y-2" style="border-color:#C9A25E55"><input class="inp" placeholder="السؤال" value="${esc(x.q)}" oninput="LXF[${i}].q=this.value"><textarea class="inp" rows="2" placeholder="الإجابة" oninput="LXF[${i}].a=this.value">${esc(x.a)}</textarea><div class="flex gap-2"><button type="button" class="ghost" onclick="lxFaqMove(${i},-1)">↑</button><button type="button" class="ghost" onclick="lxFaqMove(${i},1)">↓</button><button type="button" class="danger" onclick="lxFaqDel(${i})">حذف</button></div></div>`).join('')||'<p class="text-xs">لا توجد أسئلة.</p>'}
function lxFaqAdd(){LXF.push({q:'',a:''});lxFaqRender()}
function lxFaqDel(i){LXF.splice(i,1);lxFaqRender()}
function lxFaqMove(i,d){const j=i+d;if(j<0||j>=LXF.length)return;[LXF[i],LXF[j]]=[LXF[j],LXF[i]];lxFaqRender()}
async function lxSaveFaq(){const l=LXF.map(x=>({q:x.q.trim(),a:x.a.trim()})).filter(x=>x.q);if(await lxSet('lx_faq',l)){window.LXF=l;lxFaqRender();toast('تم حفظ الأسئلة ✅')}}
async function lxSaveUrl(){const u=$('lx_url').value.trim();if(u&&!/^https?:\/\//.test(u))return toast('الرابط لازم يبدأ بـ https://',false);const {error}=await db.from('settings').upsert({key:'store_public_url',value:u});if(error)return toast(error.message,false);S.settings.store_public_url=u;$('lx_frame').src=u;$('lx_open').href=u||'#';toast('تم الحفظ ✅')}
function lxPrev(w){$('lx_frame').style.width=typeof w==='number'?w+'px':w}
function lxCopyUrl(){const u=$('lx_url').value.trim();if(!u)return toast('اكتب الرابط الأول',false);navigator.clipboard.writeText(u);toast('تم نسخ الرابط')}
</script>
