async function setStatus(id, status) {

  const { error } = await db.from('orders').update({ status }).eq('id', id);

  if (error) return toast(error.message, false);

  S.orders.find(o => o.id === id).status = status; toast('اتحدثت الحالة ✅');

  const p = await rows('products'); S.products = p; drawOrders();

}

async function delOrder(id) {

  if (!confirm('متأكد من حذف الطلب #' + id + ' نهائياً؟')) return;

  const { error } = await db.from('orders').delete().eq('id', id);

  if (error) return toast(error.message, false);

  S.orders = S.orders.filter(o => o.id !== id); drawOrders(); toast('اتحذف');

}

